# FLX Crowdfund — Frontend environment variables
# Copy to .env and adjust for your target network.

# Address of the deployed crowdfunding contract (local Hardhat default)
VITE_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Expected chain id (31337 = local Hardhat, 11155111 = Sepolia)
VITE_CHAIN_ID=31337

# Public read-only RPC used when no wallet is connected
VITE_RPC_URL=http://localhost:8545

# Chain/network label shown in the UI
VITE_NETWORK_NAME=Local Hardhat

# Block explorer base URL used for explorer-style links
VITE_EXPLORER_URL=https://sepolia.etherscan.io