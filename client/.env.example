# RAYVIA Crowdfunding — Frontend public configuration (Sepolia testnet)
# VITE_* variables are embedded in the client bundle and are PUBLIC.
# NEVER put private keys, API keys, tokens, or secrets here.

# Deployed crowdfunding contract address on Sepolia (required)
VITE_CONTRACT_ADDRESS=

# Sepolia chain id
VITE_CHAIN_ID=11155111

# Network label shown in the UI
VITE_NETWORK_NAME=Sepolia

# Block explorer base URL
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# Public read-only RPC used for reads when no wallet is connected
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com